{
  "expo": {
    "name": "KKorea Hangul",
    "slug": "kkorea-hangul",
    "scheme": "kkorea-hangul",
    "version": "1.1.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kataro92.kkorea-hangul",
      "appleTeamId": "7HG9BF8LGF"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#EEF2FF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.spacekatcompany.kkoreanhangul",
      "versionCode": 4,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#E7DFF6",
          "dark": {
            "backgroundColor": "#141634"
          }
        }
      ],
      "./plugins/withLocalNotificationsOnly",
      "./plugins/withAutomaticSigning",
      "./plugins/withPlayUploadSigning",
      "expo-font"
    ]
  }
}
